    };

    // 1D ARRAY: Stores available screening schedules.

    static String[] showtimes = {

        "10:30 AM",

        "1:00 PM",

        "4:30 PM",

        "7:00 PM"

    };

    // REAL CINEMA BRANCHES IN LIPA CITY, BATANGAS.
    // Addresses are based on publicly listed cinema locations.
    static String[] cinemaLocations = {
        "SM Cinema Lipa - SM City Lipa",
        "Robinsons Movieworld Lipa - Robinsons Place Lipa"
    };

    static String[] cinemaAddresses = {
        "2/F SM City Lipa, Ayala Highway, Lipa City, Batangas",
        "Robinsons Place Lipa, J.P. Laurel Highway, Mataas na Lupa, Lipa City"
    };

    // 1D ARRAY: Stores ticket categories.

    static String[] ticketTypes = {

        "Regular", "Student", "Senior Citizen"

    };

    // SAMPLE VOUCHERS: These are demo codes for the school project.
    // A voucher can only be used once during the current program session.
    static String[] voucherCodes = {"CINE10", "MOVIE50"};
    static boolean[] voucherUsed = {false, false};

    // 1D ARRAY: Stores available payment methods.

    static String[] paymentMethods = {

        "Cash", "GCash", "Credit/Debit Card"

    };

    // Booking reference counter.

    static int bookingCounter = 1001;

    // ==========================================

    // 2. MAIN METHOD

    // ==========================================

    // ==========================================
    // REUSABLE LOADING AND INTERFACE METHODS
    // ==========================================

    // Reads an integer safely and rejects text or other invalid input.
    // Keeps asking until the customer enters a valid integer.
    static int readIntInput() {

        while (true) {

            if (input.hasNextInt()) {
                return input.nextInt();
            } else {
                System.out.println(RED + "Invalid input! Please enter a number." + RESET);
                input.next(); // Discards the invalid input.
                System.out.print(CYAN + "Please try again: " + RESET);
            }

        }

    }

    // Displays a simple animated loading bar.
    static void loadingScreen(String message) {

        System.out.println(CYAN + BOLD + "\n" + message + RESET);

        for (int i = 0; i <= 20; i++) {

            System.out.print("\r" + BLUE + "[" + RESET);

            for (int j = 0; j < 20; j++) {
                if (j < i) {
                    System.out.print(GREEN + "#" + RESET);
                } else {
                    System.out.print(WHITE + "-" + RESET);
                }
            }

            int percentage = i * 5;
            System.out.print(BLUE + "] " + YELLOW + percentage + "%" + RESET);

            try {
                Thread.sleep(60);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                System.out.println(RED + "\nLoading was interrupted." + RESET);
                return;
            }
        }

        System.out.println(GREEN + BOLD + "\n" + message + " - DONE!" + RESET);
        System.out.println();
    }

    // Displays a consistent heading for each section.
    static void printSectionHeader(String title) {

        System.out.println();
        System.out.println(PURPLE + BOLD + "================================================" + RESET);
        System.out.println(CYAN + BOLD + "                  " + title + RESET);
        System.out.println(PURPLE + BOLD + "================================================" + RESET);

    }

    // Displays a consistent divider between information.
    static void printDivider() {
        System.out.println(BLUE + "------------------------------------------------" + RESET);
    }

    public static void main(String[] args) {

        loadingScreen("Starting CINEBOOK");

        int choice;

        do {

            welcomeScreen();

            mainMenu();

            System.out.print(CYAN + "\nEnter your choice: " + RESET);

            choice = readIntInput();

            switch (choice) {

                case 1:

                    bookTicket();

                    break;

                case 2:

                    displayMovies();

                    break;

                case 3:

                    cinemaInformation();

                    break;

                case 4:

                    System.out.println(GREEN + "\nThank you for visiting CINEBOOK!");

                    System.out.println("Enjoy your movie experience!" + RESET);

                    break;

                default:

                    System.out.println(RED + "\nInvalid choice. Please try again." + RESET);

            }

            if (choice != 4) {

                System.out.print(YELLOW + "\nPress 1 to return to Main Menu: " + RESET);

                int back = readIntInput();

            }

        } while (choice != 4);

        input.close();

    }

